# Application
APP_NAME=BI-Platform
APP_ENV=development
APP_PORT=8000
APP_SECRET_KEY=your-super-secret-key-change-in-production
DEBUG=true

# Database
DATABASE_URL=postgresql+asyncpg://biplatform:biplatform@localhost:5432/biplatform
DATABASE_URL_SYNC=postgresql://biplatform:biplatform@localhost:5432/biplatform
SQLITE_URL=sqlite+aiosqlite:///./biplatform.db

# Redis
REDIS_URL=redis://localhost:6379/0

# Auth
JWT_SECRET_KEY=your-jwt-secret-change-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# AI / Claude API
ANTHROPIC_API_KEY=your-anthropic-api-key
AI_MODEL=claude-opus-4-8

# Search Providers (optional - system works without these)
SERPAPI_KEY=your-serpapi-key
GOOGLE_MAPS_API_KEY=your-google-maps-api-key

# Playwright
PLAYWRIGHT_HEADLESS=true
PLAYWRIGHT_TIMEOUT=30000
SCREENSHOT_DIR=./storage/screenshots

# Celery
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Rate Limiting
DEFAULT_RATE_LIMIT_REQUESTS=10
DEFAULT_RATE_LIMIT_PERIOD=60

# Export
EXPORT_DIR=./storage/exports

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000
